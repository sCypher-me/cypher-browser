{
  "name": "cypher-browser",
  "productName": "Cypher",
  "version": "0.7.42",
  "private": true,
  "description": "Navegador dark personalizável para Windows",
  "author": "Cypher",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run prepare:tracker-list && npm run prepare:proton-vpn && node scripts/dev.cjs",
    "build": "npm run prepare:tracker-list && npm run prepare:proton-vpn && tsc --noEmit && vite build && node scripts/build-preload.cjs && node scripts/changelog.cjs CHANGELOG.md dist/changelog.json",
    "start": "npm run prepare:proton-vpn && electron .",
    "prepare:privacy-runtime": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-privacy-runtime.ps1",
    "prepare:proton-vpn": "node scripts/prepare-proton-vpn.cjs",
    "prepare:tracker-list": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tracker-list.ps1",
    "dist": "npm run prepare:privacy-runtime && npm run build && electron-builder --win dir portable --publish never && node scripts/build-installer.cjs",
    "dist:installer": "npm run prepare:privacy-runtime && npm run build && electron-builder --win dir --publish never && node scripts/build-installer.cjs",
    "dist:portable": "npm run prepare:privacy-runtime && npm run build && electron-builder --win portable",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/proton-preload.cjs && node --check electron/tab-preload.cjs && node --check electron/ui-preload-entry.cjs && tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/run-smoke.cjs"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@ghostery/adblocker": "2.20.1",
    "clsx": "^2.1.1",
    "electron-chrome-extensions": "4.9.0",
    "lucide-react": "^1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "app.cypher.browser",
    "productName": "Cypher",
    "npmRebuild": false,
    "afterPack": "scripts/vmp-sign.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/proton-vpn-browser-extension/distribution-cypher",
        "to": "proton-vpn",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/proton-vpn-browser-extension/LICENSE",
        "to": "licenses/proton-vpn/LICENSE"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/source",
        "to": "licenses/proton-vpn/source",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/proton-vpn-browser-extension/config.js",
        "to": "licenses/proton-vpn/config.js"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/package.json",
        "to": "licenses/proton-vpn/package.json"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/webpack.config.js",
        "to": "licenses/proton-vpn/webpack.config.js"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/webpack-cypher.config.js",
        "to": "licenses/proton-vpn/webpack-cypher.config.js"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/webpack-directive-loader.js",
        "to": "licenses/proton-vpn/webpack-directive-loader.js"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/package-lock.json",
        "to": "licenses/proton-vpn/package-lock.json"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/readme.md",
        "to": "licenses/proton-vpn/readme.md"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/CYPHER-INTEGRATION.md",
        "to": "licenses/proton-vpn/CYPHER-INTEGRATION.md"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/.babelrc",
        "to": "licenses/proton-vpn/.babelrc"
      },
      {
        "from": "vendor/proton-vpn-browser-extension/tsconfig.json",
        "to": "licenses/proton-vpn/tsconfig.json"
      },
      {
        "from": "scripts/prepare-proton-vpn.cjs",
        "to": "licenses/proton-vpn/prepare-proton-vpn.cjs"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Cypher-${version}-Windows.${ext}",
      "extraResources": [
        {
          "from": "vendor/privacy-runtime",
          "to": "privacy-runtime",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "executableName": "cypher",
      "icon": "build/icon.png",
      "artifactName": "Cypher-${version}-Linux-${arch}.${ext}",
      "synopsis": "Navegador personalizável com Tor, I2P e proteção de privacidade",
      "description": "O Cypher é um navegador personalizável, com bloqueio de anúncios e rastreadores, rotas Tor e I2P, mods e extensões do Chrome.",
      "maintainer": "sCypher-me <sCypher-me@users.noreply.github.com>",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "Cypher",
          "Keywords": "browser;navegador;web;tor;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "tor",
        "i2pd"
      ]
    }
  },
  "license": "GPL-3.0-only",
  "homepage": "https://scypher-me.github.io/cypher-browser/"
}
