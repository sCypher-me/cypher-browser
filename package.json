{
  "name": "cypher-browser",
  "productName": "Cypher",
  "version": "0.7.13",
  "private": true,
  "description": "Navegador dark personalizável para Windows",
  "author": "Cypher",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run prepare:tracker-list && node scripts/dev.cjs",
    "build": "npm run prepare:tracker-list && tsc --noEmit && vite build",
    "start": "electron .",
    "prepare:privacy-runtime": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-privacy-runtime.ps1",
    "prepare:tracker-list": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tracker-list.ps1",
    "dist": "npm run prepare:privacy-runtime && npm run build && electron-builder --win dir portable --publish never && node scripts/build-installer.cjs",
    "dist:installer": "npm run prepare:privacy-runtime && npm run build && electron-builder --win dir --publish never && node scripts/build-installer.cjs",
    "dist:portable": "npm run prepare:privacy-runtime && npm run build && electron-builder --win portable",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/run-smoke.cjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.18.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "app.cypher.browser",
    "productName": "Cypher",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/privacy-runtime",
        "to": "privacy-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Cypher-${version}-Windows.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
