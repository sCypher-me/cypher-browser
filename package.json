{
  "name": "cypher-browser",
  "productName": "Cypher",
  "version": "0.7.6",
  "private": true,
  "description": "Navegador dark personalizável para Windows",
  "author": "Cypher",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win dir portable --publish never && node scripts/build-installer.cjs",
    "dist:installer": "npm run build && electron-builder --win dir --publish never && node scripts/build-installer.cjs",
    "dist:portable": "npm run build && electron-builder --win portable",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/run-smoke.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "app.cypher.browser",
    "productName": "Cypher",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico",
      "artifactName": "Cypher-${version}-Windows.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
